# Copia este archivo como ".env" (en la misma carpeta backend/) y
# rellena tus valores reales. El backend los lee solo, no hace falta
# reiniciar nada más que el servidor. En Render, estas mismas variables
# se configuran en el panel del servicio (pestaña "Environment"), no
# en un archivo .env.

# Clave de Google AI Studio (Gemini). Gratis, sin tarjeta de crédito.
# Sácala en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opcional: modelo de Gemini a usar (por defecto: gemini-flash-lite-latest,
# pensado para volumen alto en el nivel gratuito -el modelo "flash" a
# secas tiene un tope de solo 20 peticiones POR DÍA en el nivel
# gratuito, se agota casi de inmediato con uso real-).
# GEMINI_MODEL=gemini-flash-lite-latest

# Tasas de cambio para el motor multidivisa (3% de IGTF incluido en
# cada divisa). Formato "CODIGO:TASA", "CODIGO*TASA" o "CODIGO%TASA"
# separados por comas -agrega o quita las monedas que quieras,
# cualquier código sirve, no solo USD/COP-. El separador indica el
# modo de cálculo:
#   ":" o "=" -> "cuántos Bs. equivalen a 1 unidad de esa moneda"
#                (dividir; ej. USD:246.50 si 1 USD = Bs. 246,50).
#   "*"       -> "cuántas unidades de esa moneda equivalen a 1 Bs."
#                (multiplicar directo contra el Bs.).
#   "%"       -> "cuántas unidades de esa moneda equivalen a 1 USD"
#                (multiplicar vía dólar; así se suele conocer el peso
#                colombiano en la frontera de Táchira -ej. "el dólar
#                está en 4.000 pesos"-, ej. COP%4000. Requiere que
#                "USD" también esté configurado).
# Sin esto, el backend sigue funcionando pero usa una tasa de
# referencia aproximada -actualízalas seguido, el tipo de cambio en
# Venezuela cambia rápido-.
TASAS_CAMBIO=USD:246.50,COP%4000

# Código de acceso para proteger el backend cuando está expuesto a
# Internet (p. ej. desplegado en Render). Déjalo vacío si el backend
# solo corre en la Wi-Fi de la tienda. Debe coincidir con el que
# pongas en Ajustes dentro de la app.
APP_ACCESS_KEY=
